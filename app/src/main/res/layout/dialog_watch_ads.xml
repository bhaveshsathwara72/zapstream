<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="16dp"
        android:text="Your 7-day trial has ended"
        android:textAlignment="center"
        android:textColor="@color/ns_dark_primary"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvDesc"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="16dp"
        android:text="You can watch 2 rewarded ads to continue to use app for 1 day."
        android:textAlignment="center"
        android:textColor="@color/ns_grey_title"
        android:textSize="16sp"
        android:textStyle="bold" />

    <Button
        android:id="@+id/btnWatchAds"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bg_btn_primary"
        android:text="Watch Ads"
        android:textColor="@android:color/white" />

    <Button
        android:id="@+id/btnPurchase"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_btn_primary"
        android:text="Subscribe now"
        android:textColor="@android:color/white"
        android:visibility="gone" />

</LinearLayout>
